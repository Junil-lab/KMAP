# Nextflow run cache / logs
.nextflow/
.nextflow.log*
work/

# Large binaries (distributed separately)
PBLONGREADWGS/containers/*.sif

# Reference data (distributed separately)
PBLONGREADWGS/resources/ref/*
!PBLONGREADWGS/resources/ref/sex/
!PBLONGREADWGS/resources/ref/trgt/

# Pipeline outputs
results/

# Samplesheets (paths differ per machine) — only the samples.csv template is tracked
PBLONGREADWGS/input/kmap_*.csv
PBLONGREADWGS/input/hg002_*.csv

# Large BAM files
PBLONGREADWGS/input/*.bam
PBLONGREADWGS/input/*.bam.bai

# System files
.DS_Store
PBLONGREADWGS/containers/build_main.log
PBLONGREADWGS/containers/*.log
PBLONGREADWGS/docs/*.pptx

# Local run environment / tests (not distributed)
.java17/
tools/
test_runs/
logs/
PBLONGREADWGS/resources/downloads/

# Python bytecode
__pycache__/
*.pyc
