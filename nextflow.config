// ============================================================
// K_map PacBio WGS Pipeline v2 — Nextflow Configuration
// 완전 독립형: 모든 툴이 Singularity 컨테이너 안에 포함
// 실행 시 필수 파라미터: --samplesheet, --outdir
// ============================================================

params {
    // ── 필수 입력 (사용자 지정) ───────────────────────────────
    samplesheet  = null                          // 필수: sample_id,bam,start_step CSV
    outdir       = "${projectDir}/results"       // 출력 디렉토리

    // ── 레퍼런스 (projectDir 기준 자동 설정) ─────────────────
    ref          = "${projectDir}/resources/ref/GRCh38_no_alt_analysis_set.fna"
    ref_mmi      = "${projectDir}/resources/ref/GRCh38_no_alt_analysis_set.fna.mmi"
    trgt_catalog = "${projectDir}/resources/ref/repeat_catalog.hg38.bed"
    te_fasta     = "${projectDir}/resources/ref/TE_ref/teref.human.fa"
    steller_py   = "${projectDir}/resources/ref/sTELLeR/steller/steller.py"
    vep_cache    = "${projectDir}/resources/ref/cache"
    vep_ref_1kg  = "${projectDir}/resources/ref/GRCh38_no_alt_analysis_set.fna"
    annotsv_db   = "${projectDir}/resources/ref/AnnotSV"

    // ── 컨테이너 (projectDir 기준 자동 설정) ─────────────────
    main_sif     = "${projectDir}/containers/kmap_pbwgs_v2.sif"
    dv_sif       = "${projectDir}/containers/deepvariant_1.9.0-gpu.sif"
    vep_sif      = "${projectDir}/containers/ensembl-vep-release_115.0.sif"

    // ── 실행 옵션 ─────────────────────────────────────────────
    threads      = 16
    use_gpu      = true   // DeepVariant GPU 사용 여부
    karyotype    = 'XY'   // TRGT karyotype (XY or XX)

    // ── start_step=hiphase 시 VCF 소스 (기본: outdir) ────────
    vcf_dir      = null

}

// ── 프로세스 기본값 ───────────────────────────────────────────
// errorStrategy 정책:
//   핵심 프로세스 (JASMINE~HIPHASE, VEP, AnnotSV_SV/TE): retry 2 → 실패 시 terminate
//   선택적 프로세스 (STELLER, ANNOTSV_TR): retry 1 → 실패 시 warn (downstream 계속)
process {
    container     = params.main_sif
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'high_mem' {
        memory = '64 GB'
        cpus   = params.threads
    }
    withLabel: 'low_mem' {
        memory = '8 GB'
        cpus   = 4
    }

    // 핵심 프로세스: 실패 시 반드시 파이프라인 중단
    withName: 'JASMINE|PBMM2|DEEPVARIANT|SAWFISH|TRGT|HIPHASE|CPG_TOOLS' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    // 선택적 프로세스: 실패해도 경고만 — 단 빈 출력은 script에서 생성
    withName: 'STELLER|ANNOTSV_TR' {
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
    }

    withName: 'DEEPVARIANT' {
        container        = params.dv_sif
        containerOptions = { params.use_gpu ? "--nv" : "" }
    }
    withName: 'SNP_ANNOTATION' {
        container = params.vep_sif
    }
}

// ── Singularity ───────────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true
    runOptions = "-B ${projectDir}"
}

// ── 실행 프로파일 ─────────────────────────────────────────────
profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'gpu'
    }
}

// ── work 디렉토리 ────────────────────────────────────────────
// projectDir/.nf_work 로 고정 → ref/sif/input/work 모두 동일 트리
// → Singularity autoMounts 가 workDir 을 마운트하면 BAM 심링크도 같이 해결됨
// NXF_WORK 환경변수로 재정의 가능: export NXF_WORK=/local/path/work
workDir = System.getenv("NXF_WORK") ?: "${projectDir}/.nf_work"

// ── 타임라인 / 리포트 ─────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.csv"
    sep       = ','
    fields    = 'task_id,name,status,exit,submit,start,complete,realtime,duration,cpus,%cpu,memory,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
    overwrite = true
}
