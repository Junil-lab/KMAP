manifest {
    nextflowVersion = '>=24.10.0'
}

// ============================================================
// KMAP PacBio IsoSeq Pipeline — Nextflow Configuration
// 완전 독립형: 모든 툴이 Singularity 컨테이너 안에 포함
// ============================================================

params {
    // ── 필수 입력 ─────────────────────────────────────────────
    samplesheet     = null                        // 필수: sample_id,flnc_bam,tissue CSV
    outdir          = "${projectDir}/results"

    // ── 레퍼런스 ─────────────────────────────────────────────
    genome_fa       = "${projectDir}/resources/ref/hg38.fa"
    gencode_gtf     = "${projectDir}/resources/ref/gencode.v45.annotation.gtf"

    // SQANTI3 optional annotation
    polya_motif_list = new File("${projectDir}/resources/ref/polyA_motifs.human.txt").isFile() ? "${projectDir}/resources/ref/polyA_motifs.human.txt" : null
    polya_peak_bed   = new File("${projectDir}/resources/ref/atlas.clusters.2.0.GRCh38.96.chr.bed").isFile() ? "${projectDir}/resources/ref/atlas.clusters.2.0.GRCh38.96.chr.bed" : null
    cage_peak_bed    = new File("${projectDir}/resources/ref/hg38_fair+new_CAGE_peaks_phase1and2.bed").isFile() ? "${projectDir}/resources/ref/hg38_fair+new_CAGE_peaks_phase1and2.bed" : null

    // SQANTI3 스크립트 경로 (컨테이너 내부 경로)
    sqanti3_qc      = "/opt/SQANTI3/sqanti3_qc.py"

    // ── 컨테이너 ─────────────────────────────────────────────
    main_sif        = "${projectDir}/containers/kmap_isoseq_main.sif"
    sqanti3_sif     = "${projectDir}/containers/kmap_isoseq_sqanti3.sif"

    // ── 실행 옵션 ────────────────────────────────────────────
    threads         = 16
    methods         = 'isoquant,isocall,flair'
    analysis_mode   = 'auto' // single: per sample; multi: cohort; both: both scopes
    run_cohort      = true   // legacy setting, used only with analysis_mode=auto
    discovery_sif   = "${projectDir}/containers/kmap_isoseq_discovery.sif"
}

// ── 프로세스 설정 ─────────────────────────────────────────────
process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    beforeScript  = { "export OMP_NUM_THREADS=${task.cpus}; export OPENBLAS_NUM_THREADS=1; export MKL_NUM_THREADS=1" }
    container     = params.main_sif
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'high_mem' {
        memory = '64 GB'
        cpus   = params.threads
    }
    withLabel: 'low_mem' {
        memory = '8 GB'
        cpus   = { Math.min(params.threads.toInteger(), 4) }
    }

    // Every sample must complete SQANTI3 and QC; never silently omit failures.
    withName: 'SQANTI3' {
        container = params.sqanti3_sif
    }
    withName: 'QC_COLLECT|QC_MERGE' {
        errorStrategy = 'terminate'
    }

}

// ── Singularity ───────────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true
    runOptions = "--cleanenv -B '${projectDir}'"
}

// ── 실행 프로파일 ─────────────────────────────────────────────
profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor   = 'slurm'
        process.queue      = 'cpu'
        process.clusterOptions = '--nodes=1'
    }
}

// ── work 디렉토리 ─────────────────────────────────────────────
workDir = System.getenv("NXF_WORK") ?: "${projectDir}/.nf_work"

// ── 타임라인 / 리포트 / 트레이스 ─────────────────────────────
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.csv"
    sep       = ','
    fields    = 'task_id,name,status,exit,submit,start,complete,realtime,duration,cpus,%cpu,memory,%mem,rss,peak_rss'
    overwrite = true
}
