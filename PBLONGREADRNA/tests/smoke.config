// Resource limits for tests/run_smoke.sh; use synthetic references passed by CLI.
params {
    polya_motif_list = null
    polya_peak_bed = null
    cage_peak_bed = null
}
process {
    withLabel: high_mem { memory = '4 GB' }
    withLabel: low_mem { memory = '1 GB'; cpus = 1 }
    errorStrategy = 'terminate'
}
executor { cpus = 8; memory = '24 GB' }
