Bootstrap: docker
From: continuumio/miniconda3:24.1.2-0

%labels
    Maintainer KMAP
    FLAIRCommit c17913a2cad4ae35e5903f23061e17ba0ef5631b
    IsocallVersion 1.3.0

%files
    def/patches/flair-empty-sam.patch /opt/flair-empty-sam.patch

%post
    set -e
    export PATH=/opt/conda/bin:$PATH
    if ! command -v mamba >/dev/null; then
        conda install -y -n base --override-channels -c conda-forge mamba
    fi
    mamba create -y -n discovery --override-channels -c conda-forge -c bioconda \
        python=3.12 minimap2=2.30 samtools=1.23.1 bedtools=2.31.1 mappy=2.31 zlib pip git curl cxx-compiler
    export PATH=/opt/conda/envs/discovery/bin:$PATH
    git init /opt/flair-src
    cd /opt/flair-src
    git remote add origin https://github.com/BrooksLabUCSC/flair.git
    git fetch --depth 1 origin c17913a2cad4ae35e5903f23061e17ba0ef5631b
    git checkout --detach FETCH_HEAD
    git apply /opt/flair-empty-sam.patch
    /opt/conda/envs/discovery/bin/python -m pip install --no-cache-dir .
    mkdir -p /opt/isocall
    curl -fL --retry 3 -o /tmp/isocall.tar.gz \
        https://github.com/PacificBiosciences/isocall/releases/download/1.3.0/isocall-v1.3.0-x86_64-unknown-linux-gnu.tar.gz
    tar -xzf /tmp/isocall.tar.gz -C /opt/isocall --strip-components=1
    echo '415954f324ea5580c6347a9c4dd3aebda044da98133a11baa91ad47401d6ab5d  /opt/isocall/isocall' | sha256sum -c -
    ln -s /opt/isocall/isocall /usr/local/bin/isocall
    /opt/conda/envs/discovery/bin/python -m pip freeze > /opt/discovery-pip-freeze.txt
    mamba list -n discovery --explicit > /opt/discovery-conda-explicit.txt
    conda clean -afy
    rm /tmp/isocall.tar.gz

%environment
    export PATH=/opt/conda/envs/discovery/bin:/usr/local/bin:/opt/conda/bin:$PATH
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%runscript
    exec "$@"

%test
    set -e
    flair --version
    flair transcriptome --help >/dev/null
    flair quantify --help >/dev/null
    isocall --version
    minimap2 --version
    samtools --version >/dev/null
