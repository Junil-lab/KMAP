Bootstrap: docker
From: python:3.12.12-slim-bookworm

%labels
    Author      K_map scRNA-seq QC Pipeline
    Version     2.0.0
    Description Scanpy/scVI/SOLO environment for scRNA-seq QC and doublet removal, installed from public packages
    Tools       python=3.12.12 scanpy=1.11.5 scvi-tools=1.4.0.post1 torch=2.9.0+cu128 solo-sc=1.2 (calico/solo@d94baa3)

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        locales \
        procps
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Package versions are pinned to the environment the pipeline was validated with
    # (pip freeze of the earlier lab image). torch / nvidia-* come from the PyTorch CUDA 12.8 index.
    cat > /opt/requirements.txt << 'REQ'
        absl-py==2.3.1
        aiohappyeyeballs==2.6.1
        aiohttp==3.13.2
        aiosignal==1.4.0
        anndata==0.12.6
        array-api-compat==1.12.0
        attrs==25.4.0
        ConfigArgParse==1.7.1
        contourpy==1.3.3
        crc32c==2.8
        cycler==0.12.1
        docrep==0.3.2
        donfig==0.8.1.post1
        e==1.4.5
        filelock==3.20.0
        fonttools==4.60.1
        frozenlist==1.8.0
        fsspec==2025.10.0
        grpcio==1.76.0
        h5py==3.15.1
        idna==3.11
        igraph==1.0.0
        Jinja2==3.1.6
        joblib==1.5.2
        kiwisolver==1.4.9
        legacy-api-wrap==1.5
        leidenalg==0.11.0
        lightning==2.5.6
        lightning-utilities==0.15.2
        llvmlite==0.45.1
        Markdown==3.10
        markdown-it-py==4.0.0
        MarkupSafe==3.0.3
        matplotlib==3.10.7
        mdurl==0.1.2
        ml_collections==1.1.0
        mpmath==1.3.0
        mudata==0.3.2
        multidict==6.7.0
        natsort==8.4.0
        networkx==3.5
        numba==0.62.1
        numcodecs==0.16.3
        numpy==2.3.4
        nvidia-cublas-cu12==12.8.4.1
        nvidia-cuda-cupti-cu12==12.8.90
        nvidia-cuda-nvrtc-cu12==12.8.93
        nvidia-cuda-runtime-cu12==12.8.90
        nvidia-cudnn-cu12==9.10.2.21
        nvidia-cufft-cu12==11.3.3.83
        nvidia-cufile-cu12==1.13.1.3
        nvidia-curand-cu12==10.3.9.90
        nvidia-cusolver-cu12==11.7.3.90
        nvidia-cusparse-cu12==12.5.8.93
        nvidia-cusparselt-cu12==0.7.1
        nvidia-nccl-cu12==2.27.5
        nvidia-nvjitlink-cu12==12.8.93
        nvidia-nvshmem-cu12==3.3.20
        nvidia-nvtx-cu12==12.8.90
        opt_einsum==3.4.0
        packaging==25.0
        pandas==2.3.3
        patsy==1.0.2
        pillow==12.0.0
        propcache==0.4.1
        protobuf==6.33.0
        Pygments==2.19.2
        pynndescent==0.5.13
        pyparsing==3.2.5
        pyro-api==0.1.2
        pyro-ppl==1.9.1
        python-dateutil==2.9.0.post0
        pytorch-lightning==2.5.6
        pytz==2025.2
        PyYAML==6.0.3
        rich==14.2.0
        scanpy==1.11.5
        scikit-learn==1.7.2
        scikit-misc==0.5.2
        scipy==1.16.3
        scvi-tools==1.4.0.post1
        seaborn==0.13.2
        session-info2==0.2.3
        six==1.17.0
        sparse==0.17.0
        statsmodels==0.14.5
        sympy==1.14.0
        tensorboard==2.20.0
        tensorboard-data-server==0.7.2
        texttable==1.7.0
        threadpoolctl==3.6.0
        torch==2.9.0
        torchmetrics==1.8.2
        tqdm==4.67.1
        triton==3.5.0
        typing_extensions==4.15.0
        tzdata==2025.2
        umap-learn==0.5.9.post2
        Werkzeug==3.1.3
        xarray==2025.10.1
        yarl==1.22.0
        zarr==3.1.3
REQ
    sed -i 's/^ *//' /opt/requirements.txt
    python3 -m pip install --no-cache-dir pip==25.2 setuptools==80.9.0 wheel==0.45.1
    python3 -m pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        -r /opt/requirements.txt
    # SOLO: official calico/solo source at the validated commit (no dependency changes)
    python3 -m pip install --no-cache-dir --no-deps \
        https://github.com/calico/solo/archive/d94baa34157eaa9bfe79d87f7a04f578b2e82a4c.tar.gz
    python3 -m pip check || true

    mkdir -p /tmp/numba_cache /tmp/matplotlib

%environment
    export PYTHONNOUSERSITE=1
    export OPENBLAS_NUM_THREADS=1
    export OMP_NUM_THREADS=1
    export MKL_NUM_THREADS=1
    export NUMEXPR_NUM_THREADS=1
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export MPLCONFIGDIR=/tmp/matplotlib

%runscript
    exec "$@"

%test
    # numba / matplotlib need a writable cache directory
    export NUMBA_CACHE_DIR=$(mktemp -d) MPLCONFIGDIR=$(mktemp -d)
    python3 --version
    python3 - << 'PYEOF'
import importlib.metadata as md
import scanpy as sc
import anndata as ad
import torch
import scvi
import solo.solo
print("scanpy", sc.__version__)
print("anndata", ad.__version__)
print("torch", torch.__version__, "cuda", torch.version.cuda)
print("scvi-tools", scvi.__version__)
print("solo-sc", md.version("solo-sc"))
PYEOF
    solo --version
