// ============================================================
// K_map scRNA-seq QC Pipeline - Nextflow configuration
// ============================================================

params {
    // Required input
    samplesheet = null
    outdir      = "${projectDir}/results"

    // Cell Ranger runs from a dedicated SIF by default. The host binary is
    // kept only as an optional fallback via -profile host_cellranger.
    cellranger_sif = "${projectDir}/containers/cellranger.sif"
    cellranger_cmd = "cellranger"
    cellranger_bin = ""

    // Cell Ranger transcriptome reference. Provide this in the samplesheet or
    // with --transcriptome. The pipeline does not download references.
    transcriptome = null

    // Containers
    cellbender_sif = "${projectDir}/containers/cellbender.sif"
    qc_sif         = "${projectDir}/containers/scrnaseq_qc.sif"
    qc_conda_env   = "/home/Data_Drive_8TB/cwonkim99/.conda/envs/solo"

    // Resources
    threads   = 24
    memory_gb = 200
    use_gpu   = true
    cuda_device = "0"

    // Cell Ranger defaults
    create_bam = true
    chemistry  = "auto"
    include_introns = false
    cellranger_expect_cells = null

    // CellBender defaults
    cellbender_fpr = 0.01
    cellbender_epochs = 150
    cellbender_checkpoint_mins = 10
    cellbender_total_droplets_included = null
    cellbender_empty_drops = null

    // Scanpy QC defaults
    // Cells with pct_counts_mt >= 20 are removed.
    mt_threshold  = 20
    min_genes     = 200
    min_counts    = 500
    min_cells_gene = 5
    hvg_n_top     = 2000

    // SOLO defaults. If expected doublet rate is unknown, leave null and use
    // SOLO's score threshold. For 10x data, set per sample when possible.
    solo_json = "${projectDir}/configs/solo_params.json"
    solo_doublet_ratio = 2
    solo_expected_doublet_rate = null
    solo_seed = 1
    solo_plot = true
    solo_extra_args = ""
}

process {
    container = params.qc_sif
    errorStrategy = 'terminate'
    maxRetries = 0

    withLabel: 'cellranger' {
        container = params.cellranger_sif
        cpus = params.threads
        memory = "${params.memory_gb} GB"
    }

    withLabel: 'gpu' {
        cpus = params.threads
        memory = "${params.memory_gb} GB"
        containerOptions = { params.use_gpu ? "--nv" : "" }
    }

    withLabel: 'standard' {
        cpus = params.threads
        memory = '64 GB'
    }

    withName: 'CELLBENDER_REMOVE_BACKGROUND' {
        container = params.cellbender_sif
    }

    withName: 'SOLO_DOUBLETS' {
        container = params.qc_sif
        containerOptions = { params.use_gpu ? "--nv" : "" }
    }
}

singularity {
    enabled = true
    autoMounts = true
    runOptions = ""
}

profiles {
    local {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'gpu'
    }

    local_conda {
        process.executor = 'local'

        process {
            withName: 'SCANPY_QC_FOR_SOLO' {
                container = null
                beforeScript = """
                    export PATH=${params.qc_conda_env}/bin:\$PATH
                    export CONDA_PREFIX=${params.qc_conda_env}
                    export NUMBA_CACHE_DIR=\$PWD/numba_cache
                    export MPLCONFIGDIR=\$PWD/mpl_cache
                """
            }
            withName: 'SOLO_DOUBLETS' {
                container = null
                beforeScript = """
                    export PATH=${params.qc_conda_env}/bin:\$PATH
                    export CONDA_PREFIX=${params.qc_conda_env}
                    export NUMBA_CACHE_DIR=\$PWD/numba_cache
                    export MPLCONFIGDIR=\$PWD/mpl_cache
                """
            }
            withName: 'FILTER_SOLO_SINGLETS' {
                container = null
                beforeScript = """
                    export PATH=${params.qc_conda_env}/bin:\$PATH
                    export CONDA_PREFIX=${params.qc_conda_env}
                    export NUMBA_CACHE_DIR=\$PWD/numba_cache
                    export MPLCONFIGDIR=\$PWD/mpl_cache
                """
            }
            withName: 'QC_MERGE' {
                container = null
                beforeScript = """
                    export PATH=${params.qc_conda_env}/bin:\$PATH
                    export CONDA_PREFIX=${params.qc_conda_env}
                    export NUMBA_CACHE_DIR=\$PWD/numba_cache
                    export MPLCONFIGDIR=\$PWD/mpl_cache
                """
            }
        }
    }

    host_cellranger {
        process.executor = 'local'

        process {
            withLabel: 'cellranger' {
                container = null
            }
        }
    }
}

workDir = System.getenv("NXF_WORK") ?: "${System.getProperty('user.home')}/nf_work/K_map_scrnaseq_qc"

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.csv"
    sep = ','
    fields = 'task_id,name,status,exit,submit,start,complete,realtime,duration,cpus,%cpu,memory,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
    overwrite = true
}
