// ============================================================
// K_map PacBio WGS Pipeline v2 — Nextflow Configuration
// Fully self-contained: every tool runs inside a Singularity container
// Required parameters: --samplesheet, --outdir
// ============================================================

params {
    // ── Required input (user supplied) ───────────────────────
    samplesheet  = null                          // required: sample_id,bam,sex,start_step CSV
    outdir       = "${projectDir}/results"       // output directory

    // ── References (set relative to projectDir) ─────────────
    ref          = "${projectDir}/resources/ref/GRCh38_no_alt_analysis_set.fna"
    ref_mmi      = "${projectDir}/resources/ref/GRCh38_no_alt_analysis_set.fna.mmi"
    trgt_catalog = "${projectDir}/resources/ref/trgt/adotto_strchive_20250827.hg38.noFailTag.bed.gz"  // PacBio HiFi-human-WGS-WDL v4.0.0 (adotto + STRchive, 937,195 loci); INCLUDE_FAIL_READS tags removed (same as the WDL's process_trgt_catalog)

    methbat_regions = "${projectDir}/resources/ref/methbat/cpgIslandExt.sorted.hg38.tsv"  // CpG islands, from the MethBat repository data/ folder

    // ── Sex-dependent references (chosen by the samplesheet sex column) ──
    par_bed        = "${projectDir}/resources/ref/sex/GRCh38.PAR.bed"          // DeepVariant (XY)
    expected_cn_xx = "${projectDir}/resources/ref/sex/expected_cn.hg38.XX.bed" // Sawfish
    expected_cn_xy = "${projectDir}/resources/ref/sex/expected_cn.hg38.XY.bed" // Sawfish

    // ── Containers (set relative to projectDir) ─────────────
    main_sif     = "${projectDir}/containers/kmap_pbwgs_v2.sif"
    dv_sif       = "${projectDir}/containers/deepvariant_1.9.0-gpu.sif"
    methbat_sif  = "${projectDir}/containers/methbat_1.1.0.sif"   // docker://quay.io/biocontainers/methbat:1.1.0--h9ee0642_0

    // ── Run options ───────────────────────────────────────────
    threads      = 16
    use_gpu      = true   // use GPU for DeepVariant
    run_methbat  = true   // run MethBat alongside pb-CpG-tools (07b_MethBat)

    // ── VCF source when start_step=hiphase (default: outdir) ──
    vcf_dir      = null

}

// ── Process defaults ──────────────────────────────────────────
// errorStrategy policy:
//   core processes (JASMINE..CPG_TOOLS): retry 2 → terminate on failure
process {
    container     = params.main_sif
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'high_mem' {
        memory = '64 GB'
        cpus   = params.threads
    }
    withLabel: 'low_mem' {
        memory = '8 GB'
        cpus   = 4
    }

    // core processes: always stop the pipeline on failure
    withName: 'JASMINE|PBMM2|DEEPVARIANT|SAWFISH|TRGT|HIPHASE|CPG_TOOLS|METHBAT' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    withName: 'DEEPVARIANT' {
        container        = params.dv_sif
        containerOptions = { params.use_gpu ? "--nv" : "" }
    }
}

// ── Singularity ───────────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true
    // KMAP_EXTRA_BINDS: real locations of symlinked references (set by run.sh)
    runOptions = "-B ${projectDir}" + (System.getenv("KMAP_EXTRA_BINDS") ? " -B ${System.getenv('KMAP_EXTRA_BINDS')}" : "")
}

// ── Execution profiles ────────────────────────────────────────
profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'gpu'
    }
}

// ── work directory ───────────────────────────────────────────
// fixed to projectDir/.nf_work → ref/sif/input/work all live in one tree
// → when Singularity autoMounts mounts workDir, BAM symlinks resolve too
// override with the NXF_WORK environment variable: export NXF_WORK=/local/path/work
workDir = System.getenv("NXF_WORK") ?: "${projectDir}/.nf_work"

// ── Timeline / report ─────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.csv"
    sep       = ','
    fields    = 'task_id,name,status,exit,submit,start,complete,realtime,duration,cpus,%cpu,memory,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
    overwrite = true
}
